1151+ 794F              ConvRStr16:
1152+ 794F              ;===============================================================
1153+ 794F              ;http://z80-heaven.wikidot.com/math#toc32
1154+ 794F              ;Input:
1155+ 794F              ;     DE points to the base 10 number string in RAM.
1156+ 794F              ;Outputs:
1157+ 794F              ;     HL is the 16-bit value of the number
1158+ 794F              ;     DE points to the byte after the number
1159+ 794F              ;     BC is HL/10
1160+ 794F              ;     z flag reset (nz)
1161+ 794F              ;     c flag reset (nc)
1162+ 794F              ;Destroys:
1163+ 794F              ;     A (actually, add 30h and you get the ending token)
1164+ 794F              ;Size:  23 bytes
1165+ 794F              ;Speed: 104n+42+11c
1166+ 794F              ;       n is the number of digits
1167+ 794F              ;       c is at most n-2
1168+ 794F              ;       at most 595 cycles for any 16-bit decimal value
1169+ 794F              ;===============================================================
1170+ 794F 21 00 00          ld hl,0          ;  10 : 210000
1171+ 7952              ConvLoop:             ;
1172+ 7952 1A                ld a,(de)        ;   7 : 1A
1173+ 7953 D6 30             sub 30h          ;   7 : D630
1174+ 7955 FE 0A             cp 10            ;   7 : FE0A
1175+ 7957 D0                ret nc           ;5|11 : D0
1176+ 7958 13                inc de           ;   6 : 13
1177+ 7959                                    ;
1178+ 7959 44                ld b,h           ;   4 : 44
1179+ 795A 4D                ld c,l           ;   4 : 4D
1180+ 795B 29                add hl,hl        ;  11 : 29
1181+ 795C 29                add hl,hl        ;  11 : 29
1182+ 795D 09                add hl,bc        ;  11 : 09
1183+ 795E 29                add hl,hl        ;  11 : 29
1184+ 795F                                    ;
1185+ 795F 85                add a,l          ;   4 : 85
1186+ 7960 6F                ld l,a           ;   4 : 6F
1187+ 7961 30 EF             jr nc,ConvLoop   ;12|23: 30EE
1188+ 7963 24                inc h            ; --- : 24
1189+ 7964 18 EC             jr ConvLoop      ; --- : 18EB
