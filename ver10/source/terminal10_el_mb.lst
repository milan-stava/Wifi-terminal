 110+ 7530              ;	DEFC __IUBR_115200 = 243
 111+ 7530              ;	DEFC __IUBR_57600 = 486
 112+ 7530              ;	DEFC __IUBR_38400 = 729
 113+ 7530              ;	DEFC __IUBR_31250 = 896
 114+ 7530              ;	DEFC __IUBR_19200 = 1458
 115+ 7530              ;	DEFC __IUBR_9600 = 2916
 116+ 7530              ;	DEFC __IUBR_4800 = 5833
 117+ 7530              ;	DEFC __IUBR_2400 = 11666
