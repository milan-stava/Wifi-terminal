1442+ 7AE7 ~            oldkeys:		DEFB	0,0,0,0,0,0,0,0
1443+ 7AE7 ~            newkeys:		DEFB	0,0,0,0,0,0,0,0
1444+ 7AE7 ~            debkeys:		DEFB	0,0,0,0,0,0,0,0
1445+ 7AE7 ~
1446+ 7AE7 ~            scankeys:		ld	a,%01111111
1447+ 7AE7 ~            			ld hl,oldkeys			;previous scan results
1448+ 7AE7 ~            			ld de,newkeys			;new scan results
1449+ 7AE7 ~            			ld bc,debkeys			;debounced keys ( press initiated this frame )
1450+ 7AE7 ~            lp:			push af				;store A
1451+ 7AE7 ~            			ld a,(de)			;get previous scan's result
1452+ 7AE7 ~            			ld (hl),a			;store it in oldkey
1453+ 7AE7 ~            			pop af				;restore A
1454+ 7AE7 ~            			push af				;store A again
1455+ 7AE7 ~            			in a,(254)			;get key row
1456+ 7AE7 ~            			cpl				;invert bits 0 = not pressed 1 = pressed
1457+ 7AE7 ~            			ld (de),a			;store in newkeys
1458+ 7AE7 ~            			and (hl)			;and with old key
1459+ 7AE7 ~            			ex de,hl			;swap regs for xor
1460+ 7AE7 ~            			xor (hl)			;xor new key ( sets bit only when key initially pressed this scan )
1461+ 7AE7 ~            			ex de,hl			;swap regs back
1462+ 7AE7 ~            			ld (bc),a			;store in debounced keys
1463+ 7AE7 ~            			pop af				;restore A
1464+ 7AE7 ~            			inc  hl				;inc pointers
1465+ 7AE7 ~            			inc de				;inc pointers
1466+ 7AE7 ~            			inc bc				;inc pointers
1467+ 7AE7 ~            			rrca				;next keyrow
1468+ 7AE7 ~            			jr c,lp				;loop
1469+ 7AE7 ~
1470+ 7AE7 ~            			ld	de,KeyMap2		;point to new keymap
1471+ 7AE7 ~            			ld	a,(oldkeys+0)		;test  for symbol shift
1472+ 7AE7 ~            			and 2				;mask out symbol shift key
1473+ 7AE7 ~            			jr z,nsym			;if not pressed ship
1474+ 7AE7 ~            			ld a,(debkeys+0)		;remove symbol shift key
1475+ 7AE7 ~            			and 31-2			;remove symbol shift key
1476+ 7AE7 ~            			ld (debkeys+0),a		;remove symbol shift key
1477+ 7AE7 ~            			ld de,KeyMapS			;set Symbol Shift key table
1478+ 7AE7 ~            nsym:
1479+ 7AE7 ~            			ld	a,(oldkeys+7)		;test  for caps
1480+ 7AE7 ~            			and 1				;mask out caps key
1481+ 7AE7 ~            			jr z,ncap			;if not pressed ship
1482+ 7AE7 ~            			ld a,(debkeys+7)		;remove caps key
1483+ 7AE7 ~            			and 31-1			;remove caps key
1484+ 7AE7 ~            			ld (debkeys+7),a		;remove caps key
1485+ 7AE7 ~            			ld de,KeyMapC			;set Caps key table
1486+ 7AE7 ~            ncap:
1487+ 7AE7 ~
1488+ 7AE7 ~            			ld	hl,debkeys		;point to debounced keys
1489+ 7AE7 ~            			ld	b,8			;8 rows
1490+ 7AE7 ~            blp:			ld	a,(hl)			;get row
1491+ 7AE7 ~            			or a				;has it got a key pressed
1492+ 7AE7 ~            			jr nz,got1			;if so go to .got1
1493+ 7AE7 ~            			inc de				;point to next keymap row
1494+ 7AE7 ~            			inc de
1495+ 7AE7 ~            			inc de
1496+ 7AE7 ~            			inc de
1497+ 7AE7 ~            			inc de
1498+ 7AE7 ~            			inc hl				;point to next debounced row
1499+ 7AE7 ~            			djnz blp			;loop 8 rows
1500+ 7AE7 ~            			xor a				;nothing found
1501+ 7AE7 ~            			ret				;return
1502+ 7AE7 ~            got1:			rra				;get bit
1503+ 7AE7 ~            			jr c,gotit			;if set we've got our key
1504+ 7AE7 ~            			inc de				;point to next keymap
1505+ 7AE7 ~            			jr got1				;loop until we find which key it was
1506+ 7AE7 ~            gotit:			ld a,(de)			;get key ascii value
1507+ 7AE7 ~            			ret				;return
