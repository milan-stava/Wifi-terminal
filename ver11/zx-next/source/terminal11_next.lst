 125+ 7530              ;	DEFC	TX_CHKREADY = 4923	;133Bh Write is byte to send, when read is status 0x01 = RX_AVAIL or 0x02 - TX_READY
 126+ 7530              TX_CHKREADY	equ 4923
 127+ 7530              ;	DEFC	RX_SETBAUD = 5179	;143Bh Read is byte received, when written sets the BAUD rate. (now two bytes of prescaler TBU >.28)
 128+ 7530              RX_SETBAUD	equ 5179
 129+ 7530              ;To set BAUD prescaler first write must be 0-127 which are the lowest 7 bits (the 0 in BIT 7 resets the value loader).  Second byte must
 130+ 7530              ;be 1mmmmmml where l is the 8th bit of the prescaler and mmmmmm is the top six bits of the prescaler value (1 just stops the reset)
 131+ 7530
 132+ 7530              ;These are known in Z88DK as:
 133+ 7530
 134+ 7530              ;	DEFC __IO_UART_BAUD_RATE = 0x143b
 135+ 7530
