# file opened: terminal11_next.asm
   1  0000               DEVICE ZXSPECTRUM128
   2  0000               DEFINE ZXNEXT
   3  0000               MODULE v1
   4  0000               INCLUDE "terminal11_main.asm"
# file opened: terminal11_main.asm
   1+ 0000              ; ZX Next 1.1: ESP UART/8N1, 15 rates x 8 timings; no MB ports or power-off.
   2+ 0000              ; 06.11.2026: retain v1.0 ROM/BASIC output contract; m64 32/64 native UI.
   3+ 0000              ; Bottom editor: ROM channel 1, physical rows 22/23; UART channel 2, rows 0..21.
   4+ 0000              ; Cursor uses ROM OVER/INVERSE space; viewport is 63/127 chars plus cursor.
   5+ 0000              ; SS+E returns the host UART to 115200 from every speed; draft/history preserved.
   6+ 0000              ; SS+W clears the complete draft/cursor/history selection without transmitting.
   7+ 0000              ; Existing packed command history remains intact.
   8+ 0000              ; 06.11.2026: use native lower ROM channel; remove upper-screen row reservation.
   9+ 0000              ; Remove obsolete SPACE/BS cursor erasure from EDIT and CIPSEND toggles.
  10+ 0000              ; Scroll fix: initialise SCR_CT before startup/help strings, UI and each RX byte.
  11+ 0000              ; ROM scroll? must never wait for an interrupt-driven key while terminal uses DI.
  12+ 0000              ; Cursor fix: XOR glyph in place; moves update only two cells if window stays put.
  13+ 0000              ; Sticky window. SS+Q asks DELETE COMMAND HISTORY? (Y/N); Y alone confirms.
  14+ 0000              ; RX CR no longer wipes a cursor after ui_hide has restored the output position.
  15+ 0000              ; Editor update: cursor/end separate, insertion/backspace, 63-char 2-row sliding view.
  16+ 0000              ; LEFT=CS+5 (code 12), RIGHT=CS+8 (9), DELETE=CS+0 (8). Enter sends whole line.
  17+ 0000              ; ui_backup #6C00..#6E3F: 576 B scratch backing the two editor screen rows.
  18+ 0000              ; Standalone loader CLEAR 27647 protects scratch plus history #7000..#73FF.
  19+ 0000              ; CS+SS redisplays help and current baud, preserving draft/history.
  20+ 0000              ; Version 1.1: 1KB command history at #7000-#73FF; UP=older, DOWN=newer.
  21+ 0000              ; Packed 16-bit length + text records. Empty Enter/EOT preserve records.
  22+ 0000              ; Down past newest clears line. Long commands up to 256 bytes are supported.
  23+ 0000              ; Standalone BASIC loader must CLEAR 28671 to reserve external history RAM.
  24+ 0000              ; Version 1.1 - 05.11.2026: fix last-command recall after RX/scroll.
  25+ 0000              ; Recall derives edit pointer from printed text, never restores old ROM screen vars.
  26+ 0000              ; History stores text only (max 256 bytes); empty Enter and EOT preserve history.
  27+ 0000              ; Bound full recalled input before storing another byte. EL/MB hardware unchanged.
  28+ 0000
