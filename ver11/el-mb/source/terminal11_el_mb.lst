1275+ 7A6D                                    ;
1276+ 7A6D 85                add a,l          ;   4 : 85
1277+ 7A6E 6F                ld l,a           ;   4 : 6F
1278+ 7A6F 30 EF             jr nc,ConvLoop   ;12|23: 30EE
