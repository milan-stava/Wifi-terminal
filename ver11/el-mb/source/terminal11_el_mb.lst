1544+ 7BF5 ~            			ld bc,debkeys			;debounced keys ( press initiated this frame )
1545+ 7BF5 ~            lp:			push af				;store A
1546+ 7BF5 ~            			ld a,(de)			;get previous scan's result
1547+ 7BF5 ~            			ld (hl),a			;store it in oldkey
1548+ 7BF5 ~            			pop af				;restore A
1549+ 7BF5 ~            			push af				;store A again
1550+ 7BF5 ~            			in a,(254)			;get key row
1551+ 7BF5 ~            			cpl				;invert bits 0 = not pressed 1 = pressed
1552+ 7BF5 ~            			ld (de),a			;store in newkeys
1553+ 7BF5 ~            			and (hl)			;and with old key
1554+ 7BF5 ~            			ex de,hl			;swap regs for xor
1555+ 7BF5 ~            			xor (hl)			;xor new key ( sets bit only when key initially pressed this scan )
1556+ 7BF5 ~            			ex de,hl			;swap regs back
1557+ 7BF5 ~            			ld (bc),a			;store in debounced keys
1558+ 7BF5 ~            			pop af				;restore A
