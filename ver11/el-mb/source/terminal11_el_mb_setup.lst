1276+ 7A4C 85                add a,l          ;   4 : 85
1277+ 7A4D 6F                ld l,a           ;   4 : 6F
1278+ 7A4E 30 EF             jr nc,ConvLoop   ;12|23: 30EE
1279+ 7A50 24                inc h            ; --- : 24
