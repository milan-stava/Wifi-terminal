1566+ 7BD4 ~            			ld	a,(oldkeys+0)		;test  for symbol shift
1567+ 7BD4 ~            			and 2				;mask out symbol shift key
1568+ 7BD4 ~            			jr z,nsym			;if not pressed ship
1569+ 7BD4 ~            			ld a,(debkeys+0)		;remove symbol shift key
