1549+ 7BD4 ~            			push af				;store A again
1550+ 7BD4 ~            			in a,(254)			;get key row
1551+ 7BD4 ~            			cpl				;invert bits 0 = not pressed 1 = pressed
1552+ 7BD4 ~            			ld (de),a			;store in newkeys
1553+ 7BD4 ~            			and (hl)			;and with old key
1554+ 7BD4 ~            			ex de,hl			;swap regs for xor
1555+ 7BD4 ~            			xor (hl)			;xor new key ( sets bit only when key initially pressed this scan )
1556+ 7BD4 ~            			ex de,hl			;swap regs back
1557+ 7BD4 ~            			ld (bc),a			;store in debounced keys
1558+ 7BD4 ~            			pop af				;restore A
